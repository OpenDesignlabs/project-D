# ─── Supabase public keys (read-only, safe to expose) ─────────────────────────
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT_ID.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key_here

# ─── vectra-server connection ──────────────────────────────────────────────────
# All DB reads/writes go through vectra-server. No service key here.
VECTRA_SERVER_URL=http://localhost:3002
VECTRA_SERVER_SECRET=your_random_secret_here   # same as VECTRA_SERVER_SECRET in server .env

# ─── REMOVED (service key now in vectra-server only) ──────────────────────────
# SUPABASE_SERVICE_ROLE_KEY  ← delete this from your .env.local if it exists
