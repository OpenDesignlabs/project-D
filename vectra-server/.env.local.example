# ─── HuggingFace API keys (moved here from Studio VITE_AI_*) ──────────────────
AI_PRIMARY_KEY=hf_your_primary_key_here
AI_DEBUGGER_KEY=hf_your_debugger_key_here

# ─── Model overrides (optional) ────────────────────────────────────────────────
AI_PRIMARY_MODEL=zai-org/GLM-5:zai-org
AI_DEBUGGER_MODEL=deepseek-ai/DeepSeek-R1-0528:together

# ─── Supabase — SERVICE KEY LIVES HERE AND ONLY HERE ──────────────────────────
# Supabase Dashboard → Project Settings → API → service_role key
# Never put this in Marketplace or Studio

SUPABASE_URL=https://YOUR_PROJECT_ID.supabase.co
SUPABASE_SERVICE_KEY=your_supabase_service_role_key_here

# ─── Shared secret — all callers must send x-vectra-server-secret: <this> ──────
# Generate: openssl rand -hex 32
VECTRA_SERVER_SECRET=your_random_secret_here

# ─── CORS — Studio origin only ─────────────────────────────────────────────────
STUDIO_ORIGIN=http://localhost:5173

PORT=3002
