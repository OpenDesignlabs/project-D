{
  "name": "vectra-monorepo",
  "private": true,
  "scripts": {
    "install:all": "pnpm install",
    "build:all": "pnpm -r build",
    "dev:all": "pnpm -r --parallel dev",
    "studio:dev": "pnpm --filter vectra-studio dev",
    "server:dev": "pnpm --filter vectra-server dev",
    "market:dev": "pnpm --filter vectra-marketplace dev",
    "studio:build": "pnpm --filter vectra-studio build"
  },
  "packageManager": "pnpm@10.33.0",
  "pnpm": {
    "overrides": {
      "@types/react": "19.2.14",
      "@types/react-dom": "19.2.3"
    },
    "onlyBuiltDependencies": [
      "@swc/core",
      "esbuild"
    ]
  }
}
